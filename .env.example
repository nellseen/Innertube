# Server Configuration
PORT=3000

# Gemini API Key for server-side chord analysis and AI features
GEMINI_API_KEY=

# Optional comma-separated browser origins. Defaults to public wildcard CORS
# without credentialed cross-origin requests.
CORS_ORIGINS=*

# Set to the number of trusted reverse-proxy hops only when deployed behind one.
# Leave unset when connecting directly to the application.
TRUST_PROXY_HOPS=
